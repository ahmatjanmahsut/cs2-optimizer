{
  "name": "cs2-tuner",
  "productName": "CS2 优化助手",
  "version": "0.5.0",
  "private": true,
  "description": "帮助 CS2 新玩家快速调整显卡设置（NVIDIA/AMD）、系统电源计划、准星与持枪/鼠标参数的 Windows 桌面工具。",
  "main": "src/main/index.js",
  "scripts": {
    "start": "set ELECTRON_ENABLE_LOGGING=1&& electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-builder"
    ]
  },
  "build": {
    "appId": "tools.cs2tuner.app",
    "productName": "CS2 优化助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "CS2-Optimizer-Setup-${version}.${ext}"
    }
  }
}
